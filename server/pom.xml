<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 4.1.x 父工程，统一管理常用依赖版本（Spring AI 2.0 要求 Spring Boot 4.0+） -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.zyr</groupId>
    <artifactId>zyr-shop-server</artifactId>
    <version>1.0.0</version>
    <name>zyr-shop-server</name>
    <description>zyr_shop 基于 Spring AI2.0 的带智能客服的商城系统 - 后端服务</description>

    <properties>
        <!-- 编译版本：Spring Boot 4 / Spring AI 2.0 推荐 JDK 17+，本项目使用 JDK 21 -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Spring AI 官方物料清单版本 -->
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- Apache Tika 文档解析版本（支持 txt/doc/docx/pdf/markdown） -->
        <tika.version>2.9.2</tika.version>
        <!-- JWT 工具库版本 -->
        <jjwt.version>0.12.6</jjwt.version>
        <!-- 支付宝 SDK 版本（沙箱电脑网站支付 alipay.trade.page.pay） -->
        <alipay-sdk.version>4.39.218.ALL</alipay-sdk.version>
    </properties>

    <!-- 引入 Spring AI BOM，统一管理 spring-ai-* 系列依赖版本 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web 启动器：提供 Spring MVC、内嵌 Tomcat、Jackson 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Thymeleaf 模板引擎：用于普通用户前台页面（管理员前台使用 Vue3，位于 client 工程） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- 参数校验启动器：@Valid / @NotBlank 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Data JPA：操作 MySQL 数据库 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- MySQL 8 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis 启动器。
             Spring AI 的 Redis 向量库(RedisVectorStoreAutoConfiguration)强依赖 JedisConnectionFactory，
             因此这里排除默认的 Lettuce 客户端，改为使用 Jedis，让 Spring Boot 自动装配 Jedis 连接工厂 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <exclusions>
                <!-- 排除 Lettuce 客户端，避免其连接工厂抢先注册 -->
                <exclusion>
                    <groupId>io.lettuce</groupId>
                    <artifactId>lettuce-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Jedis 客户端（Spring AI Redis 向量库底层使用），版本由 Spring Boot 父工程管理 -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
        </dependency>
        <!-- Jedis 连接池依赖（JedisConnectionConfiguration 需要 GenericObjectPool），版本由 Spring Boot 管理 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- Spring AI - DeepSeek 对话大模型 starter（deepseek-chat） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>

        <!-- Spring AI - Redis 向量数据库 starter（底层基于 RediSearch / HNSW） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-redis</artifactId>
        </dependency>

        <!-- Spring AI - OpenAI 普通模块（非 starter，不会触发自动装配）。
             阿里云 DashScope 的 text-embedding-v3 提供 OpenAI 兼容接口，
             因此复用 OpenAiEmbeddingModel，在 AiConfig 中手动声明 EmbeddingModel -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>

        <!-- Apache Tika 核心包：自动探测文件类型 -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <!-- Apache Tika 标准解析器集合：包含 PDFBox(解析PDF)、POI(解析doc/docx)、纯文本解析等 -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>${tika.version}</version>
        </dependency>

        <!-- JWT 相关依赖：生成与校验登录令牌 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 支付宝官方 SDK：电脑网站支付(alipay.trade.page.pay)、异步通知验签、订单查询 -->
        <dependency>
            <groupId>com.alipay.sdk</groupId>
            <artifactId>alipay-sdk-java</artifactId>
            <version>${alipay-sdk.version}</version>
        </dependency>

        <!-- Lombok：编译期生成 getter/setter，简化实体与配置类代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试启动器 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot 打包插件：可打出可执行 fat-jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
